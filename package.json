{
  "name": "claw-rumble-fix",
  "version": "0.5.1",
  "description": "Decky plugin that restores MSI Claw A8 rumble after suspend/resume",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "python3 -m unittest discover -s tests -v",
    "package": "bash scripts/package.sh"
  },
  "keywords": [
    "decky",
    "plugin",
    "msi-claw",
    "rumble"
  ],
  "license": "MIT",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  }
}
